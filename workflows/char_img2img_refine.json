{
  "1": {
    "inputs": {
      "ckpt_name": "PARAM_CKPT"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint (SD1.5 only)"
    }
  },
  "2": {
    "inputs": {
      "image": "PARAM_INIT_IMAGE"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Init Image (composition to keep)"
    }
  },
  "3": {
    "inputs": {
      "pixels": ["2", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "VAE Encode"
    }
  },
  "4": {
    "inputs": {
      "text": "PARAM_PROMPT",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "5": {
    "inputs": {
      "text": "PARAM_NEGATIVE_PROMPT",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "6": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": "PARAM_INT_STEPS",
      "cfg": "PARAM_FLOAT_CFG",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": "PARAM_FLOAT_STRENGTH",
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["3", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (denoise = strength)"
    }
  },
  "7": {
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "8": {
    "inputs": {
      "filename_prefix": "PARAM_FILENAME_PREFIX",
      "images": ["7", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
