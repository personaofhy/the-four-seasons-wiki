{
  "1": {
    "inputs": {
      "ckpt_name": "PARAM_CKPT"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint (SD1.5 only: anime=Counterfeit-V3.0 / real=dreamshaper_8)"
    }
  },
  "2": {
    "inputs": {
      "ipadapter_file": "ip-adapter_sd15.safetensors"
    },
    "class_type": "IPAdapterModelLoader",
    "_meta": {
      "title": "Load IPAdapter Model"
    }
  },
  "3": {
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    },
    "class_type": "CLIPVisionLoader",
    "_meta": {
      "title": "Load CLIP Vision"
    }
  },
  "4": {
    "inputs": {
      "image": "PARAM_FACE_REF"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Face Reference (kaede_face_front_base.jpg)"
    }
  },
  "5": {
    "inputs": {
      "image": "PARAM_BODY_REF"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Body Reference (kaede_body_tpose_base.jpg)"
    }
  },
  "6": {
    "inputs": {
      "image1": ["4", 0],
      "image2": ["5", 0]
    },
    "class_type": "ImageBatch",
    "_meta": {
      "title": "Batch both references (image2 is rescaled to image1)"
    }
  },
  "7": {
    "inputs": {
      "model": ["1", 0],
      "ipadapter": ["2", 0],
      "image": ["6", 0],
      "clip_vision": ["3", 0],
      "weight": "PARAM_FLOAT_IP_WEIGHT",
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    },
    "class_type": "IPAdapterAdvanced",
    "_meta": {
      "title": "IPAdapter Advanced (face + body identity lock)"
    }
  },
  "8": {
    "inputs": {
      "text": "PARAM_PROMPT",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "9": {
    "inputs": {
      "text": "PARAM_NEGATIVE_PROMPT",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "10": {
    "inputs": {
      "width": "PARAM_INT_WIDTH",
      "height": "PARAM_INT_HEIGHT",
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  },
  "11": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": "PARAM_INT_STEPS",
      "cfg": "PARAM_FLOAT_CFG",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["7", 0],
      "positive": ["8", 0],
      "negative": ["9", 0],
      "latent_image": ["10", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "12": {
    "inputs": {
      "samples": ["11", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "13": {
    "inputs": {
      "filename_prefix": "PARAM_FILENAME_PREFIX",
      "images": ["12", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
