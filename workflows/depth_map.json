{
  "1": {
    "inputs": {
      "image": "PARAM_SOURCE_IMAGE"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Source Image (must exist in ComfyUI input)"
    }
  },
  "2": {
    "inputs": {
      "image": ["1", 0],
      "a": "PARAM_FLOAT_MIDAS_A",
      "bg_threshold": "PARAM_FLOAT_BG_THRESHOLD",
      "resolution": "PARAM_INT_RESOLUTION"
    },
    "class_type": "MiDaS-DepthMapPreprocessor",
    "_meta": {
      "title": "MiDaS Depth Map"
    }
  },
  "3": {
    "inputs": {
      "filename_prefix": "PARAM_FILENAME_PREFIX",
      "images": ["2", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Depth Map (prefix may include a subfolder)"
    }
  }
}
