{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "PARAM_CKPT" }
  },
  "2": {
    "class_type": "IPAdapterUnifiedLoaderFaceID",
    "inputs": {
      "model": ["1", 0],
      "preset": "PARAM_PRESET",
      "lora_strength": "PARAM_FLOAT_LORA_STRENGTH",
      "provider": "CUDA"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "PARAM_CHARACTER_REF" }
  },
  "4": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["2", 0],
      "ipadapter": ["2", 1],
      "image": ["3", 0],
      "weight": "PARAM_FLOAT_IP_WEIGHT",
      "weight_faceidv2": "PARAM_FLOAT_IP_WEIGHT_V2",
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": "PARAM_FLOAT_IP_END",
      "embeds_scaling": "V only"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PARAM_PROMPT", "clip": ["1", 1] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PARAM_NEGATIVE_PROMPT", "clip": ["1", 1] }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "PARAM_INT_WIDTH", "height": "PARAM_INT_HEIGHT", "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "seed": "PARAM_INT_SEED",
      "steps": "PARAM_INT_STEPS",
      "cfg": "PARAM_FLOAT_CFG",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["1", 2] }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "PARAM_FILENAME_PREFIX" }
  }
}
