{
  "1": {
    "inputs": {
      "ckpt_name": "PARAM_CKPT"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint (SDXL)"
    }
  },
  "2": {
    "inputs": {
      "lora_name": "PARAM_LORA_NAME",
      "strength_model": "PARAM_FLOAT_LORA_STRENGTH",
      "strength_clip": "PARAM_FLOAT_LORA_STRENGTH",
      "model": ["1", 0],
      "clip": ["1", 1]
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": "LoRA (lora_strength 0.0 = off)"
    }
  },
  "3": {
    "inputs": {
      "control_net_name": "controlnet-union-sdxl-1.0-promax.safetensors"
    },
    "class_type": "ControlNetLoader",
    "_meta": {
      "title": "Load ControlNet (SDXL Union Promax)"
    }
  },
  "4": {
    "inputs": {
      "control_net": ["3", 0],
      "type": "PARAM_CONTROL_TYPE_A"
    },
    "class_type": "SetUnionControlNetType",
    "_meta": {
      "title": "Union type A (structure - usually depth)"
    }
  },
  "5": {
    "inputs": {
      "control_net": ["3", 0],
      "type": "PARAM_CONTROL_TYPE_B"
    },
    "class_type": "SetUnionControlNetType",
    "_meta": {
      "title": "Union type B (detail - usually canny or tile)"
    }
  },
  "6": {
    "inputs": {
      "image": "PARAM_CONTROL_IMAGE_A"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Control Image A (must match control_type_a)"
    }
  },
  "7": {
    "inputs": {
      "image": "PARAM_CONTROL_IMAGE_B"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Control Image B (must match control_type_b)"
    }
  },
  "8": {
    "inputs": {
      "text": "PARAM_PROMPT",
      "clip": ["2", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "9": {
    "inputs": {
      "text": "PARAM_NEGATIVE_PROMPT",
      "clip": ["2", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "10": {
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "control_net": ["4", 0],
      "image": ["6", 0],
      "strength": "PARAM_FLOAT_CN_A_STRENGTH",
      "start_percent": 0.0,
      "end_percent": "PARAM_FLOAT_CN_A_END"
    },
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {
      "title": "Apply ControlNet A (structure)"
    }
  },
  "11": {
    "inputs": {
      "positive": ["10", 0],
      "negative": ["10", 1],
      "control_net": ["5", 0],
      "image": ["7", 0],
      "strength": "PARAM_FLOAT_CN_B_STRENGTH",
      "start_percent": 0.0,
      "end_percent": "PARAM_FLOAT_CN_B_END"
    },
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {
      "title": "Apply ControlNet B (detail) - stacked on top of A"
    }
  },
  "12": {
    "inputs": {
      "width": "PARAM_INT_WIDTH",
      "height": "PARAM_INT_HEIGHT",
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image (match the control images' aspect)"
    }
  },
  "13": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": "PARAM_INT_STEPS",
      "cfg": "PARAM_FLOAT_CFG",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["2", 0],
      "positive": ["11", 0],
      "negative": ["11", 1],
      "latent_image": ["12", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "14": {
    "inputs": {
      "samples": ["13", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "15": {
    "inputs": {
      "filename_prefix": "PARAM_FILENAME_PREFIX",
      "images": ["14", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
