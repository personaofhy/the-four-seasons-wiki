{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "PARAM_UNET", "weight_dtype": "PARAM_WEIGHT_DTYPE" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "PARAM_CLIP", "type": "flux2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "PARAM_VAE" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PARAM_PROMPT", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["4", 0], "guidance": "PARAM_FLOAT_GUIDANCE" }
  },
  "6": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["5", 0] }
  },
  "7": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "PARAM_SAMPLER" }
  },
  "8": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": "PARAM_INT_STEPS",
      "width": "PARAM_INT_WIDTH",
      "height": "PARAM_INT_HEIGHT"
    }
  },
  "9": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "PARAM_INT_SEED" }
  },
  "10": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": "PARAM_INT_WIDTH",
      "height": "PARAM_INT_HEIGHT",
      "batch_size": 1
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["9", 0],
      "guider": ["6", 0],
      "sampler": ["7", 0],
      "sigmas": ["8", 0],
      "latent_image": ["10", 0]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": { "images": ["12", 0], "filename_prefix": "PARAM_FILENAME_PREFIX" }
  }
}
